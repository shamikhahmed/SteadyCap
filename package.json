{
  "name": "steadycap",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "serve": "python3 -m http.server 8768",
    "cap:init": "npx cap add ios 2>/dev/null || true && npx cap sync ios",
    "cap:sync": "npx cap sync ios",
    "cap:ios": "npx cap open ios",
    "test:e2e": "playwright test",
    "verify": "playwright test",
    "gallery": "CAPTURE_GALLERY=1 playwright test tests/gallery.spec.js",
    "gallery:view": "python3 -m http.server 8768",
    "tier1": "node ../capricorn-tooling/shared/testing/tier1.mjs",
    "test:matrix": "FINISH_MATRIX=1 playwright test tests/finish-matrix.spec.mjs --workers=1",
    "axe": "node scripts/capture-axe.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^7.2.0",
    "@playwright/test": "^1.52.0"
  },
  "dependencies": {
    "@capacitor/core": "^7.2.0",
    "@capacitor/ios": "^7.2.0"
  }
}
